<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#c87983">
<title>JS Nettoyage Services</title>
<style>
:root{--rose:#c87983;--rose2:#f7e8ea;--rose3:#ead0d4;--black:#171717;--gold:#d7a33b;--bg:#faf8f8;--white:#fff;--green:#3d8b61}
*{box-sizing:border-box}body{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--black)}
header{background:linear-gradient(135deg,#fff 0%,var(--rose2) 100%);padding:18px 18px 12px;border-bottom:1px solid var(--rose3);position:sticky;top:0;z-index:3}
.logo{width:105px;height:105px;object-fit:contain;display:block;margin:auto;border-radius:20px}.brand{text-align:center;font-weight:800;font-size:20px;margin-top:6px}.tag{text-align:center;color:#777;font-size:12px}
main{padding:16px 14px 92px;max-width:760px;margin:auto}.view{display:none}.view.active{display:block}
h1{font-size:25px;margin:8px 0 4px}.sub{color:#777;margin:0 0 16px}
.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.card{background:var(--white);border:1px solid #eee;border-radius:16px;padding:15px;box-shadow:0 2px 10px #00000008}.big{font-size:25px;font-weight:800}.label{font-size:12px;color:#777;margin-top:4px}
.btn{border:0;border-radius:13px;padding:12px 14px;font-weight:700;font-size:14px;cursor:pointer;background:var(--rose);color:white}.btn.secondary{background:var(--rose2);color:#8f4d56}.btn.dark{background:#171717}.btn.danger{background:#b94d5b}.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}
.list{display:grid;gap:10px;margin-top:12px}.item{background:#fff;border:1px solid #eee;border-radius:15px;padding:14px}.item h3{margin:0 0 5px;font-size:17px}.muted{color:#777;font-size:13px;line-height:1.45}
input,textarea,select{width:100%;padding:12px;border:1px solid #ddd;border-radius:11px;background:#fff;font:inherit}textarea{min-height:80px;resize:vertical}.field{margin:10px 0}.field label{font-size:12px;font-weight:700;display:block;margin-bottom:5px}.modal{position:fixed;inset:0;background:#0008;display:none;align-items:flex-end;z-index:10}.modal.open{display:flex}.sheet{background:#fff;width:100%;max-height:90vh;overflow:auto;border-radius:22px 22px 0 0;padding:18px}.sheet h2{margin:0 0 12px}.empty{text-align:center;padding:28px 12px;color:#777}
nav{position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #eee;display:grid;grid-template-columns:repeat(5,1fr);z-index:5;padding:7px 4px max(7px,env(safe-area-inset-bottom))}
nav button{border:0;background:transparent;font-size:11px;color:#777;padding:5px 1px}nav button.active{color:var(--rose);font-weight:800}nav span{display:block;font-size:20px;margin-bottom:2px}
.small{font-size:12px}.pill{display:inline-block;background:var(--rose2);color:#8f4d56;padding:4px 8px;border-radius:20px;font-size:11px;font-weight:700}
</style>
</head>
<body>
<header>
<img class="logo" src="data:image/png;base64,">
<div class="brand">JS Nettoyage Services</div>
<div class="tag">La propreté, notre priorité ❤️</div>
</header>
<main>
<section id="home" class="view active">
<h1>Bonjour 👋</h1><p class="sub">Ton tableau de bord</p>
<div class="cards">
<div class="card"><div class="big" id="statLog">0</div><div class="label">Logements</div></div>
<div class="card"><div class="big" id="statInt">0</div><div class="label">Interventions</div></div>
<div class="card"><div class="big" id="statCli">0</div><div class="label">Clients</div></div>
<div class="card"><div class="big" id="statCa">0 €</div><div class="label">CA enregistré</div></div>
</div>
<div class="card" style="margin-top:12px"><div class="row between"><b>Prochaines interventions</b><button class="btn secondary" onclick="openIntervention()">+ Ajouter</button></div><div id="nextHome"></div></div>
</section>

<section id="logements" class="view">
<div class="row between"><div><h1>🏠 Logements</h1><p class="sub">Tous tes logements</p></div><button class="btn" onclick="openLogement()">+ Ajouter</button></div>
<div id="logementsList" class="list"></div>
</section>

<section id="planning" class="view">
<div class="row between"><div><h1>📅 Planning</h1><p class="sub">Toutes tes interventions, au même endroit</p></div><button class="btn" onclick="openIntervention()">+ Ajouter</button></div>
<div id="planningList" class="list"></div>
</section>

<section id="clients" class="view">
<div class="row between"><div><h1>👥 Clients</h1><p class="sub">Propriétaires et conciergeries</p></div><button class="btn" onclick="openClient()">+ Ajouter</button></div>
<div id="clientsList" class="list"></div>
</section>

<section id="finance" class="view">
<h1>💰 Finances</h1><p class="sub">Suivi des prestations</p>
<div class="cards"><div class="card"><div class="big" id="caTotal">0 €</div><div class="label">CA enregistré</div></div><div class="card"><div class="big" id="caCount">0</div><div class="label">Prestations</div></div></div>
<div id="financeList" class="list"></div>
</section>
</main>

<nav>
<button data-v="home" class="active" onclick="show('home')"><span>🏠</span>Accueil</button>
<button data-v="logements" onclick="show('logements')"><span>🏡</span>Logements</button>
<button data-v="planning" onclick="show('planning')"><span>📅</span>Planning</button>
<button data-v="clients" onclick="show('clients')"><span>👥</span>Clients</button>
<button data-v="finance" onclick="show('finance')"><span>💰</span>Finances</button>
</nav>

<div id="modal" class="modal" onclick="if(event.target===this)closeModal()"><div class="sheet" id="sheet"></div></div>

<script>
const KEY='jsns_v2_data';
let db=JSON.parse(localStorage.getItem(KEY)||'{"logements":[],"clients":[],"interventions":[]}');
function save(){localStorage.setItem(KEY,JSON.stringify(db));render()}
function esc(s){return String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]))}
function eur(n){return (Number(n)||0).toLocaleString('fr-FR',{minimumFractionDigits:0,maximumFractionDigits:2})+' €'}
function show(id){document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById(id).classList.add('active');document.querySelectorAll('nav button').forEach(b=>b.classList.toggle('active',b.dataset.v===id));render()}
function openModal(content){document.getElementById('sheet').innerHTML=content;document.getElementById('modal').classList.add('open')}
function closeModal(){document.getElementById('modal').classList.remove('open')}
function openLogement(){
openModal(`<h2>🏠 Nouveau logement</h2>
<div class="field"><label>Nom du logement *</label><input id="l_nom" placeholder="Ex. Appartement Bourg-en-Bresse"></div>
<div class="field"><label>Adresse</label><input id="l_addr" placeholder="Adresse complète"></div>
<div class="field"><label>Ville</label><input id="l_city"></div>
<div class="field"><label>Client / conciergerie</label><input id="l_client" placeholder="Nom du client"></div>
<div class="field"><label>Plateforme</label><select id="l_platform"><option>Airbnb</option><option>Booking</option><option>Abritel</option><option>Autre</option></select></div>
<div class="field"><label>Tarif du ménage (€)</label><input id="l_price" type="number" min="0" step="0.01"></div>
<div class="field"><label>Durée prévue (minutes)</label><input id="l_duration" type="number" min="0"></div>
<div class="field"><label>Accès / boîte à clés</label><textarea id="l_access"></textarea></div>
<div class="field"><label>Consignes particulières</label><textarea id="l_notes"></textarea></div>
<div class="row"><button class="btn secondary" onclick="closeModal()">Annuler</button><button class="btn" onclick="addLogement()">Enregistrer</button></div>`)
}
function addLogement(){
let name=document.getElementById('l_nom').value.trim(); if(!name){alert('Indique le nom du logement.');return}
db.logements.push({id:Date.now(),name,address:l_addr.value,city:l_city.value,client:l_client.value,platform:l_platform.value,price:Number(l_price.value)||0,duration:Number(l_duration.value)||0,access:l_access.value,notes:l_notes.value});
save();closeModal();show('logements')
}
function editLogement(id){
let l=db.logements.find(x=>x.id===id); if(!l)return;
openModal(`<h2>✏️ Modifier le logement</h2>
<div class="field"><label>Nom du logement *</label><input id="l_nom" value="${esc(l.name)}"></div>
<div class="field"><label>Adresse</label><input id="l_addr" value="${esc(l.address||'')}"></div>
<div class="field"><label>Ville</label><input id="l_city" value="${esc(l.city||'')}"></div>
<div class="field"><label>Client / conciergerie</label><input id="l_client" value="${esc(l.client||'')}"></div>
<div class="field"><label>Plateforme</label><select id="l_platform"><option ${l.platform==='Airbnb'?'selected':''}>Airbnb</option><option ${l.platform==='Booking'?'selected':''}>Booking</option><option ${l.platform==='Abritel'?'selected':''}>Abritel</option><option ${l.platform==='Autre'?'selected':''}>Autre</option></select></div>
<div class="field"><label>Tarif du ménage (€)</label><input id="l_price" type="number" min="0" step="0.01" value="${Number(l.price)||0}"></div>
<div class="field"><label>Durée prévue (minutes)</label><input id="l_duration" type="number" min="0" value="${Number(l.duration)||0}"></div>
<div class="field"><label>Accès / boîte à clés</label><textarea id="l_access">${esc(l.access||'')}</textarea></div>
<div class="field"><label>Consignes particulières</label><textarea id="l_notes">${esc(l.notes||'')}</textarea></div>
<div class="row"><button class="btn secondary" onclick="closeModal()">Annuler</button><button class="btn" onclick="updateLogement(${id})">Enregistrer</button></div>`)
}
function updateLogement(id){
let l=db.logements.find(x=>x.id===id); if(!l)return;
let name=document.getElementById('l_nom').value.trim(); if(!name){alert('Indique le nom du logement.');return}
Object.assign(l,{name,address:l_addr.value,city:l_city.value,client:l_client.value,platform:l_platform.value,price:Number(l_price.value)||0,duration:Number(l_duration.value)||0,access:l_access.value,notes:l_notes.value});
save();closeModal();show('logements')
}
function openClient(){
openModal(`<h2>👥 Nouveau client</h2><div class="field"><label>Nom *</label><input id="c_nom"></div><div class="field"><label>Téléphone</label><input id="c_tel" type="tel"></div><div class="field"><label>Email</label><input id="c_mail" type="email"></div><div class="field"><label>Notes</label><textarea id="c_notes"></textarea></div><div class="row"><button class="btn secondary" onclick="closeModal()">Annuler</button><button class="btn" onclick="addClient()">Enregistrer</button></div>`)
}
function addClient(){let name=c_nom.value.trim();if(!name){alert('Indique le nom du client.');return}db.clients.push({id:Date.now(),name,tel:c_tel.value,mail:c_mail.value,notes:c_notes.value});save();closeModal();show('clients')}
function openIntervention(){
let opts=db.logements.map(l=>`<option value="${l.id}">${esc(l.name)} — ${esc(l.city)}</option>`).join('');
if(!opts){alert('Ajoute d’abord un logement.');show('logements');return}
openModal(`<h2>🧹 Nouvelle intervention</h2><div class="field"><label>Logement *</label><select id="i_log">${opts}</select></div><div class="field"><label>Date *</label><input id="i_date" type="date" value="${new Date().toISOString().slice(0,10)}"></div><div class="field"><label>Heure</label><input id="i_time" type="time"></div><div class="field"><label>Tarif (€)</label><input id="i_price" type="number" step="0.01"></div><div class="field"><label>Statut</label><select id="i_status"><option>À faire</option><option>Terminé</option></select></div><div class="field"><label>Note</label><textarea id="i_note"></textarea></div><div class="row"><button class="btn secondary" onclick="closeModal()">Annuler</button><button class="btn" onclick="addIntervention()">Enregistrer</button></div>`);
document.getElementById('i_log').onchange=()=>{let l=db.logements.find(x=>x.id==i_log.value);i_price.value=l?.price||''};document.getElementById('i_log').dispatchEvent(new Event('change'))
}
function addIntervention(){let l=db.logements.find(x=>x.id==i_log.value);if(!l)return;db.interventions.push({id:Date.now(),logementId:l.id,date:i_date.value,time:i_time.value,price:Number(i_price.value)||0,status:i_status.value,note:i_note.value});save();closeModal();show('planning')}
function del(type,id){if(confirm('Supprimer cet élément ?')){db[type]=db[type].filter(x=>x.id!==id);save()}}
function finish(id){let x=db.interventions.find(i=>i.id===id);if(x){x.status='Terminé';save()}}
function render(){
statLog.textContent=db.logements.length;statInt.textContent=db.interventions.length;statCli.textContent=db.clients.length;
let total=db.interventions.reduce((s,x)=>s+(Number(x.price)||0),0);statCa.textContent=eur(total);caTotal.textContent=eur(total);caCount.textContent=db.interventions.length;
logementsList.innerHTML=db.logements.length?db.logements.map(l=>`<div class="item"><div class="row between"><h3>🏠 ${esc(l.name)}</h3><span class="pill">${esc(l.platform)}</span></div><div class="muted">📍 ${esc(l.address||'Adresse non renseignée')} ${esc(l.city||'')}</div><div class="muted">👤 ${esc(l.client||'Client non renseigné')} · 💶 ${eur(l.price)} · ⏱️ ${l.duration||0} min</div><div class="muted" style="margin-top:6px">🔑 ${esc(l.access||'Aucune consigne d’accès')}</div><div class="row" style="margin-top:9px"><button class="btn secondary" onclick="openInterventionFor(${l.id})">+ Intervention</button><button class="btn secondary" onclick="editLogement(${l.id})">Modifier</button><button class="btn danger" onclick="del('logements',${l.id})">Supprimer</button></div></div>`).join(''):'<div class="empty">Aucun logement pour le moment.<br><br><button class="btn" onclick="openLogement()">+ Ajouter mon premier logement</button></div>';
planningList.innerHTML=renderInterventions();
nextHome.innerHTML=db.interventions.length?renderInterventions(true):'<div class="empty">Aucune intervention programmée.<br><br><button class="btn" onclick="show(\'logements\');openLogement()">+ Ajouter mon premier logement</button></div>';
clientsList.innerHTML=db.clients.length?db.clients.map(c=>`<div class="item"><h3>👤 ${esc(c.name)}</h3><div class="muted">📞 ${esc(c.tel||'—')} · ✉️ ${esc(c.mail||'—')}</div><div class="muted">${esc(c.notes||'')}</div><div class="row" style="margin-top:9px"><button class="btn danger" onclick="del('clients',${c.id})">Supprimer</button></div></div>`).join(''):'<div class="empty">Aucun client enregistré.</div>';
financeList.innerHTML=db.interventions.length?[...db.interventions].sort((a,b)=>(b.date||'').localeCompare(a.date||'')).map(i=>{let l=db.logements.find(x=>x.id===i.logementId);return `<div class="item"><div class="row between"><b>${esc(l?.name||'Logement supprimé')}</b><b>${eur(i.price)}</b></div><div class="muted">${esc(i.date)} ${esc(i.time||'')} · ${esc(i.status)}</div></div>`}).join(''):'<div class="empty">Aucune prestation.</div>'
}
function renderInterventions(short=false){
let arr=[...db.interventions].sort((a,b)=>((a.date||'')+' '+(a.time||'')).localeCompare((b.date||'')+' '+(b.time||'')));
if(short)arr=arr.slice(0,5);
return arr.map(i=>{let l=db.logements.find(x=>x.id===i.logementId);return `<div class="item"><div class="row between"><h3>🧹 ${esc(l?.name||'Logement')}</h3><span class="pill">${esc(i.status)}</span></div><div class="muted">📅 ${esc(i.date)} ${esc(i.time||'')} · 💶 ${eur(i.price)}</div><div class="muted">${esc(i.note||'')}</div><div class="row" style="margin-top:9px">${i.status!=='Terminé'?`<button class="btn" onclick="finish(${i.id})">✓ Terminé</button>`:''}<button class="btn danger" onclick="del('interventions',${i.id})">Supprimer</button></div></div>`}).join('')
}
function openInterventionFor(id){openIntervention();setTimeout(()=>{if(document.getElementById('i_log')){i_log.value=id;i_log.dispatchEvent(new Event('change'))}},0)}
render();
</script>
</body>
</html>
